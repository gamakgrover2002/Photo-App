// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  posts     Photos[]
  createdAt DateTime @default(now())
}

model Photos {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  url        String
  alt        String
  uploadedBy String   @db.ObjectId
  user       User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
}
